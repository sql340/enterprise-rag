# Embedding 模型
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true

# 使用 OpenAI 兼容 Embedding 服务时填写；本地模型模式忽略
EMBEDDING_API_BASE_URL=http://localhost:8000/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=

# E5 等模型需要前缀；bge-m3 默认为空。需要保留末尾空格时可加引号
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=

# Qdrant。切换 Embedding 模型或向量维度时请同时更换 collection 名称
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_knowledge_bge_m3
QDRANT_TEXT_INDEX_FIELD=content
QDRANT_ENABLE_TEXT_INDEX=true
# 生产环境保持 true：启动时补齐 ACL 过滤字段和 BM25 文本索引。
# 服务启动时若 collection 不存在，会按当前 Embedding 维度自动创建。
QDRANT_CREATE_PAYLOAD_INDEXES=true
RAG_BOOTSTRAP_SEARCH_INDEXES=true

# OpenAI 兼容 LLM
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=120

# 在线检索与 API
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=
RAG_MAX_CONTEXT_CHARS=12000
RAG_RETRIEVAL_MODE=hybrid_graph
RAG_CANDIDATE_MULTIPLIER=4
RAG_MAX_CANDIDATES=100
RAG_RRF_K=60
RAG_DENSE_WEIGHT=1.0
RAG_KEYWORD_WEIGHT=0.8

# Graph RAG。图谱只返回候选 chunk_id，正文仍从 Qdrant 按 ACL 读取
RAG_GRAPH_ENABLED=true
RAG_GRAPH_STORE_PATH=.cache/knowledge_graph.sqlite3
RAG_GRAPH_WEIGHT=0.8
RAG_GRAPH_MAX_HOPS=1
RAG_GRAPH_ENTITY_LIMIT=20

# 知识权限。启用后必须由可信网关注入 X-Tenant-Id、X-User-Id 等身份头，
# 并配置同一个共享密钥；未配置时查询接口返回 503。
RAG_ACL_ENABLED=true
RAG_ACL_PROXY_TOKEN=

# 知识治理、上传与构建任务。管理控制台位于 /admin。
RAG_GOVERNANCE_DB_PATH=.cache/knowledge_governance.sqlite3
RAG_UPLOAD_DIR=.cache/knowledge_uploads
RAG_ADMIN_MAX_FILE_BYTES=52428800

# 持久化构建 worker。任务通过 SQLite 租约领取，进程重启后会恢复 pending
# 和租约过期的 running 任务。多实例必须共享同一个治理库路径/存储卷。
RAG_INGESTION_WORKER_ENABLED=true
RAG_INGESTION_POLL_SECONDS=1
RAG_INGESTION_LEASE_SECONDS=1800
RAG_INGESTION_MAX_ATTEMPTS=3

# 可选 CrossEncoder 重排。首次使用会下载模型；关闭时保持原融合排序。
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_DEVICE=
RAG_RERANK_CANDIDATES=30

# 父子块命中的子块会自动扩展为父块上下文，父块仍要经过同一 ACL 过滤。
RAG_EXPAND_PARENT_CONTEXT=true

API_TITLE='Enterprise RAG API'
API_CORS_ORIGINS=

# 可观测性。默认输出 JSON 日志并暴露 /metrics；生产环境建议限制 /metrics 访问。
RAG_LOG_LEVEL=INFO
RAG_LOG_FORMAT=json
RAG_ACCESS_LOG_ENABLED=true
RAG_METRICS_ENABLED=true
RAG_WARMUP_EMBEDDING=true

# Embedding / LLM 健康检查结果缓存，避免探针直接打爆模型服务。
RAG_DEPENDENCY_HEALTH_CACHE_SECONDS=15
RAG_DEPENDENCY_HEALTH_TIMEOUT_SECONDS=2
RAG_DEPENDENCY_HEALTH_EXTERNAL_ENABLED=true
RAG_DEPENDENCY_HEALTH_FAIL_READINESS=false
# 企业网关没有 /models 时填写轻量健康检查地址。
RAG_DEPENDENCY_HEALTH_LLM_URL=
RAG_DEPENDENCY_HEALTH_EMBEDDING_URL=
